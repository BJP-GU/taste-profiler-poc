# Must be the secret key that starts with sk-ant- (shown once when created).
# Do not use the Console key id (apikey_01...); that cannot call the API.
ANTHROPIC_API_KEY=sk-ant-api03-...

# Change this if this model gets deprecated by the time you run this.
# Check https://docs.claude.com/en/docs/about-claude/models for current options.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
